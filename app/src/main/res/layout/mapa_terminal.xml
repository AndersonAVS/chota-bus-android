<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/chota_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <!-- Cabecera con el marco y los colores de Chota Bus. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@color/chota_purple" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/btn_volver_terminal" android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:text="‹" android:textSize="32sp" android:textColor="@color/white"
                android:contentDescription="@string/viaje_volver" android:clickable="true" android:focusable="true"
                android:background="?android:attr/selectableItemBackground" />
            <com.app.transporte_chota_bus.ui.marca.LogoChotaView android:id="@+id/logo_chota_cabecera" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
            <Space android:layout_width="48dp" android:layout_height="1dp" />
        </LinearLayout>
        <TextView android:id="@+id/texto_tipo_terminal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/chota_text" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="@string/terminal_descripcion" android:textColor="@color/chota_muted" android:textSize="15sp" />
        <!-- Selecciona solo los puntos de embarque y llegada del viaje actual. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="16dp">
            <Button android:id="@+id/btn_terminal_embarque" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="48dp" android:text="@string/terminal_embarque" android:textAllCaps="false" />
            <Button android:id="@+id/btn_terminal_llegada" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="48dp" android:layout_marginStart="8dp"
                android:text="@string/terminal_llegada" android:textAllCaps="false" />
        </LinearLayout>
        <!-- Estados de carga o ubicacion pendiente, sin simular un mapa real. -->
        <TextView android:id="@+id/texto_estado_mapa" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:padding="12dp" android:textColor="@color/chota_purple" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/progreso_mapa" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center_horizontal" android:visibility="gone" />
        <Button android:id="@+id/btn_reintentar_mapa" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/viaje_reintentar" android:textAllCaps="false" android:visibility="gone" />
        <androidx.fragment.app.FragmentContainerView android:id="@+id/contenedor_mapa"
            android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="14dp" android:visibility="gone" />
        <!-- Informacion del terminal recibida de PostgreSQL mediante la API. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:background="@color/white" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/texto_nombre_terminal" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="18sp" android:textStyle="bold" android:textColor="@color/chota_text" />
            <TextView android:id="@+id/texto_ciudad_terminal" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textColor="@color/chota_purple" />
            <TextView android:id="@+id/texto_direccion_terminal" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textSize="15sp" android:textColor="@color/chota_muted" />
        </LinearLayout>
        <Button android:id="@+id/btn_como_llegar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:layout_marginTop="18dp" android:backgroundTint="@color/chota_red"
            android:text="@string/terminal_como_llegar" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
