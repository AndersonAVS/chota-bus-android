<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/chota_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <!-- Cabecera y resumen de la salida seleccionada. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:background="@color/chota_purple">
            <Button android:id="@+id/btn_volver_compra" android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="@string/viaje_volver" android:textAllCaps="false" />
            <com.app.transporte_chota_bus.ui.marca.LogoChotaView android:id="@+id/logo_chota_cabecera" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:background="@color/white" android:padding="16dp" android:orientation="vertical">
            <TextView android:id="@+id/texto_ruta_compra" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/chota_text" />
            <TextView android:id="@+id/texto_horario_compra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/chota_muted" />
            <TextView android:id="@+id/texto_embarque_compra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/chota_text" />
            <TextView android:id="@+id/texto_llegada_compra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/chota_text" />
        </LinearLayout>
        <!-- Inventario real: los botones se generan con las filas y columnas del servidor. -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:text="@string/compra_titulo" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/chota_text" />
        <TextView android:id="@+id/texto_cantidad_compra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/chota_muted" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/compra_leyenda" android:textColor="@color/chota_text" />
        <Button android:id="@+id/btn_actualizar_asientos" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/compra_actualizar" android:textAllCaps="false" />
        <ProgressBar android:id="@+id/progreso_compra" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
        <TextView android:id="@+id/texto_error_compra" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp"
            android:textColor="@color/chota_red" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/btn_sesion_compra" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/compra_iniciar_sesion" android:visibility="gone" />
        <!-- Carroceria y cabina decorativas; los unicos asientos elegibles vienen del inventario. -->
        <LinearLayout android:id="@+id/marco_combi" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp" android:layout_marginTop="12dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/fondo_combi">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/combi_frente" android:gravity="center"
                android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.12" android:textColor="@color/chota_muted" />
            <View android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginHorizontal="26dp" android:layout_marginTop="8dp" android:background="@drawable/parabrisas_combi" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="90dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/volante_combi" android:importantForAccessibility="no" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/combi_conductor" android:textSize="12sp" android:textColor="@color/chota_purple" />
                </LinearLayout>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="@string/combi_cabina" android:gravity="center" android:textColor="@color/chota_muted" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/etiqueta_pasillo_combi" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:orientation="horizontal">
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.55" android:text="@string/combi_pasillo" android:gravity="center" android:textColor="@color/chota_muted" android:textSize="8sp" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/filas_asientos" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/combi_posterior" android:gravity="center" android:textColor="@color/chota_muted" android:textSize="10sp" android:letterSpacing="0.12" />
        </LinearLayout>
        <TextView android:id="@+id/texto_asiento_seleccionado" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textColor="@color/chota_purple" android:textStyle="bold" />
        <!-- Total estimado y estado de la reserva temporal, sin simular un pago. -->
        <TextView android:id="@+id/texto_etiqueta_total" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:textColor="@color/chota_text" />
        <TextView android:id="@+id/texto_total_compra" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="23sp" android:textStyle="bold" android:textColor="@color/chota_red" />
        <TextView android:id="@+id/texto_estado_reserva" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="12dp" android:textColor="@color/chota_purple" android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/compra_aviso_reserva" android:textColor="@color/chota_muted" />
        <Button android:id="@+id/btn_reservar_asientos" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:layout_marginTop="18dp" android:text="@string/compra_reservar" android:textAllCaps="false" android:backgroundTint="@color/chota_red" android:textColor="@color/white" />
        <Button android:id="@+id/btn_datos_pasajeros" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/pasajeros_continuar" android:textAllCaps="false" android:backgroundTint="@color/chota_red" android:textColor="@color/white" android:visibility="gone" />
        <Button android:id="@+id/btn_cancelar_reserva" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/compra_cancelar" android:textAllCaps="false" android:backgroundTint="@color/chota_purple" android:textColor="@color/white" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
