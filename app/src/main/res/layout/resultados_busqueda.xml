<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@color/chota_background">
    <!-- Cabecera y filtros de la consulta seleccionada. -->
    <Button android:id="@+id/btn_volver_resultados" android:layout_width="wrap_content" android:layout_height="48dp"
        android:text="@string/viaje_volver" android:textAllCaps="false" android:backgroundTint="@color/chota_purple" android:textColor="@color/white" />
    <TextView android:id="@+id/texto_ruta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp" android:background="@color/chota_purple" android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold" />
    <TextView android:id="@+id/texto_fecha_resultados" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:textColor="@color/chota_text" />
    <Button android:id="@+id/btn_cambiar_busqueda" android:layout_width="wrap_content" android:layout_height="48dp"
        android:text="@string/viaje_cambiar" android:textAllCaps="false" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/viajes_titulo"
        android:textSize="21sp" android:textStyle="bold" android:textColor="@color/chota_text" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:text="@string/viajes_disponibilidad" android:textColor="@color/chota_muted" />
    <!-- Estados visibles durante la consulta, si falla o no hay coincidencias. -->
    <ProgressBar android:id="@+id/progreso_viajes" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="center_horizontal" android:visibility="gone" />
    <TextView android:id="@+id/estado_viajes" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:textColor="@color/chota_purple" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/btn_reintentar_viajes" android:layout_width="wrap_content" android:layout_height="48dp"
        android:text="@string/viaje_reintentar" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/lista_salidas" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" />
</LinearLayout>
