<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chota_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="40dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <!-- Nombre de la empresa -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="CHOTA BUS"
            android:textColor="@color/chota_purple"
            android:textSize="36sp"
            android:textStyle="bold|italic" />

        <!-- Detalle de color de la marca -->
        <View
            android:layout_width="120dp"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:background="@color/chota_yellow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Nacimos pensando en usted"
            android:textColor="@color/chota_muted"
            android:textSize="16sp"
            android:textStyle="italic" />

        <!-- Ilustración provisional -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="32dp"
            android:background="#EFE7F3">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ilustración de un bus"
                android:gravity="center"
                android:text="🚌"
                android:textSize="100sp" />
        </FrameLayout>

        <!-- Mensaje de bienvenida -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="Viaja con confianza"
            android:textColor="@color/chota_purple"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Encuentra tu próximo destino y compra tus boletos de manera fácil y segura."
            android:textColor="@color/chota_muted"
            android:textSize="16sp" />

        <!-- Estado de la sesión -->
        <TextView
            android:id="@+id/texto_estado_bienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/chota_purple"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_reintentar_bienvenida"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/reintentar_sesion"
            android:textAllCaps="false"
            android:visibility="gone" />

        <!-- Acceso obligatorio a una cuenta -->
        <Button
            android:id="@+id/btn_bienvenida_login"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="@color/chota_red"
            android:text="Iniciar sesión"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_bienvenida_registro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/chota_purple"
            android:text="Crear cuenta"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Lajas · Chota · Cajamarca · Jaén"
            android:textColor="@color/chota_muted"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>