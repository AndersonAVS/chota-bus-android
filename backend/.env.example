# Configuracion local del servidor. No compartas el archivo .env.
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=chota_bus
PGUSER=postgres
PGPASSWORD=REEMPLAZAR_CON_TU_CLAVE_LOCAL

# Proyecto Firebase cuyos ID tokens verifica la API. No es una clave privada.
FIREBASE_PROJECT_ID=chota-bus

# Solo desarrollo: nunca habilitar dinero ficticio en produccion.
PAGOS_PRUEBA_HABILITADOS=false
